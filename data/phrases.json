        { "zh": "熟能生巧。", "pinyin": "Shú néng shēng qiǎo.", "en": "Practice makes perfect." },
        { "zh": "学无止境。", "pinyin": "Xué wú zhǐjìng.", "en": "There is no end to learning." },
        { "zh": "好好学习，天天向上。", "pinyin": "Hǎohǎo xuéxí, tiāntiān xiàngshàng.", "en": "Study well and make progress every day." },
        { "zh": "有志者事竟成。", "pinyin": "Yǒu zhì zhě shì jìng chéng.", "en": "Where there's a will, there's a way." },
        { "zh": "三人行，必有我师。", "pinyin": "Sān rén xíng, bì yǒu wǒ shī.", "en": "Among any three people, one can be my teacher." },
